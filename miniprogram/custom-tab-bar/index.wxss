.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 5000;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  padding-top: 8rpx;
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  padding: 0 8rpx 4rpx;
}

.tab-bar-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.tab-bar-icon-wrap--active {
  background: rgba(74, 144, 217, 0.16);
  box-shadow:
    0 6rpx 18rpx rgba(74, 144, 217, 0.38),
    0 2rpx 6rpx rgba(74, 144, 217, 0.22),
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.75);
  transform: scale(1.08);
}

.tab-bar-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-bar-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.2;
}
