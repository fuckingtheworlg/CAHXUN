<view class="tab-bar">
  <view
    class="tab-bar-item"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-bar-icon-wrap {{selected === index ? 'tab-bar-icon-wrap--active' : ''}}">
      <image class="tab-bar-icon" src="{{item.iconPath}}" mode="aspectFit" />
    </view>
    <text
      class="tab-bar-text"
      style="color: {{selected === index ? selectedColor : color}}"
    >{{item.text}}</text>
  </view>
</view>
