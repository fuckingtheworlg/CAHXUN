page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  /* 与 custom-tab-bar 占位一致，避免内容被遮挡 */
  --tab-bar-area: calc(108rpx + env(safe-area-inset-bottom));
}

.container {
  padding: 20rpx 24rpx;
}

.tab-page-pad {
  padding-bottom: var(--tab-bar-area);
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.loading-tip {
  text-align: center;
  color: #bbb;
  padding: 30rpx 0;
  font-size: 24rpx;
}
