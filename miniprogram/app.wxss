page {
  background-color: var(--c-bg-base);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: var(--c-text);
  line-height: 1.6;
  /* 与 custom-tab-bar 占位一致，避免内容被遮挡 */
  --tab-bar-area: calc(108rpx + env(safe-area-inset-bottom));

  /* ========== 默认主题（vibrant 紫色梦境）========== */
  --c-primary: #6b38d4;
  --c-primary-2: #8455ef;
  --c-accent: #3fe1fd;
  --c-warn: #ff7e5f;
  --c-bg-base: #fef7ff;
  --c-bg-page: linear-gradient(180deg, #fef7ff 0%, #f8f1fe 320rpx);
  --c-hero: linear-gradient(135deg, #6b38d4 0%, #8455ef 50%, #fbc2eb 100%);
  --c-hero-blob-1: radial-gradient(circle, #fbc2eb 0%, transparent 70%);
  --c-hero-blob-2: radial-gradient(circle, #3fe1fd 0%, transparent 70%);
  --c-hero-blob-3: radial-gradient(circle, #c4ab01 0%, transparent 70%);
  --c-card: #ffffff;
  --c-card-soft: rgba(107, 56, 212, 0.06);
  --c-text: #1d1a23;
  --c-text-dim: #7b7486;
  --c-divider: #ede5f3;
  --shadow-card: 0 4rpx 24rpx rgba(107, 56, 212, 0.1);
  --shadow-hero: 0 12rpx 32rpx rgba(107, 56, 212, 0.22);
  --shadow-primary: 0 8rpx 24rpx rgba(107, 56, 212, 0.35);
  --shadow-warn: 0 4rpx 16rpx rgba(255, 78, 80, 0.3);
  --r-card: 28rpx;
  --r-card-sm: 20rpx;
  --r-btn: 40rpx;
  --r-pill: 9999rpx;
  --c-tabbar-active-bg: rgba(107, 56, 212, 0.16);
  --c-tabbar-active-shadow: 0 6rpx 18rpx rgba(107, 56, 212, 0.38), 0 2rpx 6rpx rgba(107, 56, 212, 0.22), inset 0 2rpx 6rpx rgba(255, 255, 255, 0.75);
  --c-tabbar-selected-text: #6b38d4;
}

/* ========== Ethos Premium（极简学术 — 清新薄荷绿版）========== */
.theme-ethos {
  --c-primary: #3a9b85;
  --c-primary-2: #5cb89e;
  --c-accent: #a8e6cf;
  --c-warn: #e8a87c;
  --c-bg-base: #f6faf9;
  --c-bg-page: linear-gradient(180deg, #f6faf9 0%, #eef7f3 320rpx);
  --c-hero: linear-gradient(135deg, #5cb89e 0%, #7dc8b0 50%, #a8e6cf 100%);
  --c-hero-blob-1: radial-gradient(circle, #c8eddf 0%, transparent 70%);
  --c-hero-blob-2: radial-gradient(circle, #b3e0d2 0%, transparent 70%);
  --c-hero-blob-3: radial-gradient(circle, #e8a87c 0%, transparent 70%);
  --c-card: #ffffff;
  --c-card-soft: rgba(58, 155, 133, 0.08);
  --c-text: #2a3a36;
  --c-text-dim: #7d8a86;
  --c-divider: #e3ece9;
  --shadow-card: 0 4rpx 16rpx rgba(58, 155, 133, 0.08);
  --shadow-hero: 0 10rpx 28rpx rgba(58, 155, 133, 0.18);
  --shadow-primary: 0 6rpx 18rpx rgba(58, 155, 133, 0.3);
  --shadow-warn: 0 4rpx 12rpx rgba(232, 168, 124, 0.32);
  --r-card: 16rpx;
  --r-card-sm: 10rpx;
  --r-btn: 14rpx;
  --r-pill: 9999rpx;
  --c-tabbar-active-bg: rgba(58, 155, 133, 0.14);
  --c-tabbar-active-shadow: 0 6rpx 16rpx rgba(58, 155, 133, 0.32), 0 2rpx 6rpx rgba(58, 155, 133, 0.18), inset 0 2rpx 6rpx rgba(255, 255, 255, 0.75);
  --c-tabbar-selected-text: #3a9b85;
}

/* ========== Azure Vitality（海蓝活力）========== */
.theme-azure {
  --c-primary: #00a3ff;
  --c-primary-2: #00629d;
  --c-accent: #00dfc1;
  --c-warn: #ff7e67;
  --c-bg-base: #faf8ff;
  --c-bg-page: linear-gradient(180deg, #faf8ff 0%, #eaedff 320rpx);
  --c-hero: linear-gradient(135deg, #00629d 0%, #00a3ff 60%, #00dfc1 100%);
  --c-hero-blob-1: radial-gradient(circle, #98cbff 0%, transparent 70%);
  --c-hero-blob-2: radial-gradient(circle, #26fedc 0%, transparent 70%);
  --c-hero-blob-3: radial-gradient(circle, #ff7e67 0%, transparent 70%);
  --c-card: #ffffff;
  --c-card-soft: rgba(0, 163, 255, 0.06);
  --c-text: #131b2e;
  --c-text-dim: #6f7883;
  --c-divider: #dae2fd;
  --shadow-card: 0 4rpx 20rpx rgba(0, 163, 255, 0.1);
  --shadow-hero: 0 12rpx 32rpx rgba(0, 163, 255, 0.22);
  --shadow-primary: 0 6rpx 18rpx rgba(0, 163, 255, 0.35);
  --shadow-warn: 0 4rpx 16rpx rgba(255, 126, 103, 0.32);
  --r-card: 24rpx;
  --r-card-sm: 16rpx;
  --r-btn: 16rpx;
  --r-pill: 9999rpx;
  --c-tabbar-active-bg: rgba(0, 163, 255, 0.16);
  --c-tabbar-active-shadow: 0 6rpx 18rpx rgba(0, 163, 255, 0.4), 0 2rpx 6rpx rgba(0, 163, 255, 0.2), inset 0 2rpx 6rpx rgba(255, 255, 255, 0.75);
  --c-tabbar-selected-text: #00a3ff;
}

.container {
  padding: 20rpx 24rpx;
}

.tab-page-pad {
  padding-bottom: var(--tab-bar-area);
}

.empty-tip {
  text-align: center;
  color: var(--c-text-dim);
  padding: 80rpx 0;
  font-size: 28rpx;
}

.loading-tip {
  text-align: center;
  color: var(--c-text-dim);
  padding: 30rpx 0;
  font-size: 24rpx;
}
