.search-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #f5f5f5;
  padding: 16rpx 0 24rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 28rpx;
  height: 80rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 80rpx;
}

.search-clear {
  font-size: 28rpx;
  color: #ccc;
  padding: 10rpx;
}

.search-hint {
  text-align: center;
  padding: 120rpx 0;
}

.hint-text {
  font-size: 28rpx;
  color: #bbb;
}

.result-count {
  font-size: 24rpx;
  color: #999;
  padding: 16rpx 0;
}
