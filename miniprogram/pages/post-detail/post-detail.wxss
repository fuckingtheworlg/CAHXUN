.page {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f5ff 0%, #f5f5f5 320rpx);
  padding: 24rpx 24rpx 0;
  overflow-x: hidden;
}

/* ─── 装饰 ─── */
.top-deco {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 360rpx;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}

.deco-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(50rpx);
  opacity: 0.45;
}

.deco-1 {
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, #6FB1FC 0%, transparent 70%);
  top: -120rpx;
  left: -80rpx;
}

.deco-2 {
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, #a18cd1 0%, transparent 70%);
  top: -60rpx;
  right: -40rpx;
}

/* ─── Loading ─── */
.page-loading {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  padding: 200rpx 0;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4A90D9;
  animation: bounce 1.2s infinite ease-in-out both;
}

.loading-dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

/* ─── 主卡片 ─── */
.main-card {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx 32rpx 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(74, 144, 217, 0.1);
  margin-bottom: 24rpx;
}

.post-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.header-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.post-category {
  display: inline-block;
  font-size: 22rpx;
  color: #4A90D9;
  background: linear-gradient(135deg, rgba(74,144,217,.12), rgba(111,177,252,.2));
  padding: 4rpx 18rpx;
  border-radius: 24rpx;
  font-weight: 600;
  align-self: flex-start;
}

.post-time {
  font-size: 22rpx;
  color: #99a4b3;
}

.post-stats {
  display: flex;
  gap: 12rpx;
}

.stat-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 126, 95, 0.08);
  border-radius: 24rpx;
  padding: 6rpx 16rpx;
}

.stat-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

.view-dot {
  background: linear-gradient(135deg, #ff7e5f, #feb47b);
}

.stat-text {
  font-size: 22rpx;
  color: #ff7e5f;
  font-weight: 600;
}

.post-body {
  margin-bottom: 24rpx;
}

.post-content {
  font-size: 30rpx;
  color: #2c3e50;
  line-height: 1.8;
  word-break: break-all;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 16rpx;
  background: #f0f2f5;
}

/* ─── 评论卡片 ─── */
.comments-card {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx 16rpx;
  box-shadow: 0 8rpx 28rpx rgba(74, 144, 217, 0.06);
}

.comments-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed #eef0f3;
}

.comments-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title-mark {
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #4A90D9, #a18cd1);
  border-radius: 4rpx;
}

.comments-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3e50;
}

.comments-count {
  font-size: 22rpx;
  color: #99a4b3;
  background: #f3f5f9;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.comments-tip {
  font-size: 20rpx;
  color: #c0c8d4;
}

.comments-list {
  padding-top: 16rpx;
}

.comment-item {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx dashed #f0f2f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f0f2f5;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.comment-nickname {
  font-size: 26rpx;
  color: #2c3e50;
  font-weight: 600;
}

.comment-time {
  font-size: 22rpx;
  color: #aab2bd;
}

.comment-content {
  font-size: 28rpx;
  color: #2c3e50;
  line-height: 1.6;
  display: block;
  margin-bottom: 8rpx;
}

.comment-actions {
  display: flex;
  gap: 24rpx;
}

.comment-like-text, .comment-reply-text {
  font-size: 22rpx;
  color: #99a4b3;
}

.comments-end {
  text-align: center;
  padding: 28rpx 0 16rpx;
}

.comments-end-text {
  font-size: 22rpx;
  color: #c0c8d4;
}

/* ─── 底部操作栏 ─── */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #eef0f3;
  z-index: 50;
  backdrop-filter: blur(20rpx);
}

.comment-input-wrap {
  flex: 1;
  background: #f4f6fa;
  border-radius: 40rpx;
  padding: 0 28rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
}

.comment-placeholder {
  font-size: 26rpx;
  color: #aab2bd;
}

.like-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 24rpx;
  height: 72rpx;
  border-radius: 40rpx;
  background: #f4f6fa;
  transition: all 0.2s;
}

.like-btn.liked {
  background: linear-gradient(135deg, #ff7e5f, #ff4e50);
  box-shadow: 0 4rpx 16rpx rgba(255, 78, 80, 0.3);
}

.heart {
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.like-btn.liked .heart {
  transform: scale(1.15);
}

.heart-icon {
  font-size: 36rpx;
  line-height: 1;
  color: #aab2bd;
}

.like-btn.liked .heart-icon {
  color: #fff;
}

.like-count {
  font-size: 26rpx;
  color: #99a4b3;
  font-weight: 600;
  min-width: 32rpx;
  text-align: center;
}

.like-btn.liked .like-count {
  color: #fff;
}

/* ─── 评论提示 ─── */
.comment-tip-toast {
  position: fixed;
  left: 50%;
  bottom: 240rpx;
  transform: translateX(-50%) translateY(20rpx);
  background: rgba(44, 62, 80, 0.9);
  color: #fff;
  font-size: 24rpx;
  padding: 16rpx 28rpx;
  border-radius: 24rpx;
  opacity: 0;
  pointer-events: none;
  transition: all 0.25s;
  z-index: 100;
}

.comment-tip-toast.show {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
}
