.page {
  min-height: 100vh;
  background: var(--c-bg-page);
}

/* ─── Hero ─── */
.hero {
  position: relative;
  padding: 40rpx 36rpx 56rpx;
  overflow: hidden;
  background: var(--c-hero);
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-hero);
}

.hero-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(40rpx);
  opacity: 0.55;
  pointer-events: none;
}

.blob-1 {
  width: 280rpx;
  height: 280rpx;
  background: var(--c-hero-blob-1);
  top: -80rpx;
  right: -60rpx;
}

.blob-2 {
  width: 220rpx;
  height: 220rpx;
  background: var(--c-hero-blob-2);
  bottom: -40rpx;
  left: -40rpx;
  opacity: 0.4;
}

.blob-3 {
  width: 160rpx;
  height: 160rpx;
  background: var(--c-hero-blob-3);
  top: 80rpx;
  left: 60%;
  opacity: 0.35;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-greeting {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255,255,255,.2);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  margin-bottom: 18rpx;
  backdrop-filter: blur(10rpx);
}

.greeting-emoji-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 700;
  background: rgba(255,255,255,.3);
  border-radius: 50%;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.greeting-text {
  font-size: 22rpx;
  color: rgba(255,255,255,.95);
}

.hero-title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
  line-height: 1.2;
  text-shadow: 0 4rpx 16rpx rgba(0,0,0,.1);
}

.hero-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,.8);
}

.hero-stats {
  display: flex;
  gap: 18rpx;
  margin-top: 36rpx;
}

.stat-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,.18);
  border: 1rpx solid rgba(255,255,255,.25);
  border-radius: 20rpx;
  padding: 16rpx 30rpx;
  backdrop-filter: blur(10rpx);
  min-width: 130rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.1;
}

.stat-label {
  font-size: 20rpx;
  color: rgba(255,255,255,.75);
  margin-top: 4rpx;
}

/* ─── Content ─── */
.content {
  padding: 0 24rpx 20rpx;
}

.section-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 4rpx 24rpx;
}

.section-mark {
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, var(--c-primary), var(--c-primary-2));
  border-radius: 4rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--c-text);
  letter-spacing: 0.5rpx;
}

/* ─── Empty / Loading / End ─── */
.empty-tip {
  text-align: center;
  color: #999;
  padding: 100rpx 0;
  font-size: 28rpx;
}

.loading-tip {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  padding: 36rpx 0;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--c-primary);
  animation: loading-bounce 1.2s infinite ease-in-out both;
}

.loading-dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes loading-bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

.end-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 36rpx 0;
}

.end-line {
  width: 60rpx;
  height: 1rpx;
  background: #ddd;
}

.end-text {
  font-size: 22rpx;
  color: #bbb;
}
