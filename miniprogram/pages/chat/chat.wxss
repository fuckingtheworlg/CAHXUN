.chat-page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #f0f5ff 0%, #f5f5f5 400rpx);
  overflow: hidden;
}

/* ─── 背景装饰光斑 ─── */
.chat-bg-deco {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 600rpx;
  pointer-events: none;
  overflow: hidden;
}

.bg-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: 0.5;
}

.bg-blob-1 {
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, #6FB1FC 0%, transparent 70%);
  top: -100rpx;
  left: -80rpx;
}

.bg-blob-2 {
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, #a18cd1 0%, transparent 70%);
  top: -40rpx;
  right: -60rpx;
}

.bg-blob-3 {
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, #fbc2eb 0%, transparent 70%);
  top: 200rpx;
  left: 50%;
  opacity: 0.4;
}

.chat-list {
  position: relative;
  flex: 1;
  padding: 24rpx 12rpx;
  overflow-y: auto;
  z-index: 1;
}

/* ─── Welcome ─── */
.welcome {
  padding: 40rpx 28rpx 20rpx;
}

.welcome-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, rgba(255,255,255,.7), rgba(255,255,255,.95));
  border-radius: 32rpx;
  border: 1rpx solid rgba(255,255,255,.6);
  box-shadow: 0 12rpx 32rpx rgba(74, 144, 217, 0.12);
  margin-bottom: 40rpx;
  backdrop-filter: blur(20rpx);
}

.welcome-icon-wrap {
  position: relative;
  margin-bottom: 28rpx;
}

.welcome-icon-glow {
  position: absolute;
  top: -20rpx;
  left: -20rpx;
  right: -20rpx;
  bottom: -20rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(74,144,217,.4) 0%, transparent 70%);
  filter: blur(20rpx);
}

.welcome-icon {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4A90D9 0%, #a18cd1 100%);
  color: #fff;
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
}

.welcome-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #2c3e50;
  margin-bottom: 12rpx;
  background: linear-gradient(135deg, #4A90D9, #a18cd1);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.welcome-desc {
  font-size: 26rpx;
  color: #99a4b3;
  text-align: center;
  line-height: 1.6;
}

.hints-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 4rpx 20rpx;
}

.hints-mark {
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #4A90D9, #a18cd1);
  border-radius: 4rpx;
}

.hints-title-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #2c3e50;
}

.welcome-hints {
  width: 100%;
}

.hint-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 217, 0.06);
  transition: all .15s;
}

.hint-item-hover {
  transform: translateX(8rpx);
  box-shadow: 0 2rpx 8rpx rgba(74, 144, 217, 0.04);
}

.hint-tag {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
}

.hint-text {
  flex: 1;
  font-size: 28rpx;
  color: #2c3e50;
  line-height: 1.5;
}

/* ─── Input bar ─── */
.input-bar {
  position: relative;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-bottom: var(--tab-bar-area);
  background: rgba(255, 255, 255, 0.95);
  border-top: 1rpx solid #eef0f3;
  gap: 16rpx;
  backdrop-filter: blur(20rpx);
  z-index: 2;
}

.input-wrap {
  flex: 1;
  background: #f4f6fa;
  border-radius: 40rpx;
  padding: 0 32rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid transparent;
  transition: all .2s;
}

.input-wrap:focus-within {
  border-color: #4A90D9;
  background: #fff;
  box-shadow: 0 0 0 6rpx rgba(74, 144, 217, 0.08);
}

.msg-input {
  width: 100%;
  font-size: 28rpx;
  height: 80rpx;
}

.send-btn {
  width: 132rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #dadfe6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
}

.send-btn.active {
  background: linear-gradient(135deg, #4A90D9 0%, #a18cd1 100%);
  box-shadow: 0 6rpx 16rpx rgba(74, 144, 217, 0.35);
}

.send-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 2rpx;
}
