.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.chat-list {
  flex: 1;
  padding: 24rpx 8rpx;
  overflow-y: auto;
}

/* Welcome */
.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx 40rpx;
}

.welcome-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.welcome-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 48rpx;
}

.welcome-hints {
  width: 100%;
}

.hint-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #4A90D9;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.hint-item:active {
  background: #f0f5ff;
}

/* Input bar */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-bottom: var(--tab-bar-area);
  background: #fff;
  border-top: 1rpx solid #eee;
  gap: 16rpx;
}

.input-wrap {
  flex: 1;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
}

.msg-input {
  width: 100%;
  font-size: 28rpx;
  height: 72rpx;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s;
}

.send-btn.active {
  background: #4A90D9;
}

.send-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}
