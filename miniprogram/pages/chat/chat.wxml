<view class="chat-page">
  <scroll-view
    class="chat-list"
    scroll-y
    scroll-into-view="{{scrollToId}}"
    scroll-with-animation
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="welcome" wx:if="{{messages.length === 0}}">
      <view class="welcome-icon">🎓</view>
      <text class="welcome-title">校园墙 AI 助手</text>
      <text class="welcome-desc">我可以根据校园墙上的帖子内容回答你的问题</text>
      <view class="welcome-hints">
        <view class="hint-item" bindtap="onHintTap" data-text="最近有人捡到校园卡吗？">
          最近有人捡到校园卡吗？
        </view>
        <view class="hint-item" bindtap="onHintTap" data-text="食堂有什么新菜推荐？">
          食堂有什么新菜推荐？
        </view>
        <view class="hint-item" bindtap="onHintTap" data-text="最近有什么活动？">
          最近有什么活动？
        </view>
      </view>
    </view>

    <block wx:for="{{messages}}" wx:key="id">
      <chat-bubble
        role="{{item.role}}"
        content="{{item.content}}"
        typing="{{item.typing}}"
      />
    </block>

    <view id="scroll-bottom" style="height: 20rpx;"></view>
  </scroll-view>

  <view class="input-bar">
    <view class="input-wrap">
      <input
        class="msg-input"
        placeholder="问点什么..."
        value="{{inputValue}}"
        bindinput="onInputChange"
        bindconfirm="onSend"
        confirm-type="send"
        disabled="{{sending}}"
        maxlength="500"
      />
    </view>
    <view class="send-btn {{inputValue.trim() && !sending ? 'active' : ''}}" bindtap="onSend">
      <text class="send-text">{{sending ? '...' : '发送'}}</text>
    </view>
  </view>
</view>
