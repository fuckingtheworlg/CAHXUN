.page {
  position: relative;
  min-height: 100vh;
  background: var(--c-bg-page);
  padding: 24rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.top-deco {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}

.deco-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(50rpx);
  opacity: 0.4;
}

.deco-1 {
  width: 280rpx;
  height: 280rpx;
  background: var(--c-hero-blob-1);
  top: -80rpx;
  right: -60rpx;
}

.deco-2 {
  width: 220rpx;
  height: 220rpx;
  background: var(--c-hero-blob-2);
  top: 40rpx;
  left: -40rpx;
}

.form-card {
  position: relative;
  z-index: 1;
  background: var(--c-card);
  border-radius: var(--r-card);
  padding: 28rpx 28rpx 16rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
}

.form-section {
  padding: 8rpx 0 20rpx;
}

.form-divider {
  height: 1rpx;
  background: var(--c-divider);
  margin: 0 -8rpx;
}

.content-input {
  width: 100%;
  min-height: 320rpx;
  font-size: 30rpx;
  color: var(--c-text);
  line-height: 1.6;
  padding: 4rpx 0 12rpx;
  box-sizing: border-box;
}

.content-placeholder {
  color: var(--c-text-dim);
  font-size: 28rpx;
}

.length-counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--c-text-dim);
}

.length-counter .warn {
  color: var(--c-warn);
  font-weight: 600;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
  padding: 8rpx 0 0;
}

.label-mark {
  width: 6rpx;
  height: 22rpx;
  background: linear-gradient(180deg, var(--c-primary), var(--c-primary-2));
  border-radius: 3rpx;
}

.label-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--c-text);
}

.label-tip {
  font-size: 22rpx;
  color: var(--c-text-dim);
}

/* ─── 图片选择 ─── */
.img-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.img-cell {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: var(--r-card-sm);
  overflow: hidden;
  background: var(--c-card-soft);
}

.img-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.img-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 32rpx;
  line-height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.img-add {
  aspect-ratio: 1 / 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: var(--r-card-sm);
  border: 2rpx dashed var(--c-divider);
  background: var(--c-card-soft);
  color: var(--c-text-dim);
  transition: all .15s;
}

.img-add:active {
  border-color: var(--c-primary);
  color: var(--c-primary);
}

.img-add-plus {
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.img-add-text {
  font-size: 22rpx;
}

.cat-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.cat-chip {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--r-pill);
  background: var(--c-card-soft);
  color: var(--c-text-dim);
  transition: all .15s;
  border: 2rpx solid transparent;
}

.cat-chip-active {
  background: var(--c-card-soft);
  color: var(--c-primary);
  border-color: var(--c-primary);
  font-weight: 600;
}

.hint-card {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  background: var(--c-card-soft);
  border-radius: var(--r-card-sm);
  padding: 20rpx 24rpx;
  position: relative;
  z-index: 1;
}

.hint-icon {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--c-primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  font-style: italic;
  font-family: Georgia, serif;
}

.hint-text {
  flex: 1;
  font-size: 22rpx;
  color: var(--c-text-dim);
  line-height: 1.6;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--c-divider);
  backdrop-filter: blur(20rpx);
  z-index: 50;
}

.cancel-btn, .submit-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-btn);
  font-size: 30rpx;
  font-weight: 600;
  transition: all .15s;
}

.cancel-btn {
  background: var(--c-card-soft);
  color: var(--c-text);
  flex: 0 0 200rpx;
}

.submit-btn {
  background: linear-gradient(135deg, var(--c-primary), var(--c-primary-2));
  color: #fff;
  opacity: 0.45;
}

.submit-btn-active {
  opacity: 1;
  box-shadow: var(--shadow-primary);
}

.cancel-btn:active, .submit-btn-active:active {
  opacity: 0.85;
}
