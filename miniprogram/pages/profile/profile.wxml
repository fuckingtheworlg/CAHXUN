<!-- ===== 未登录引导页 ===== -->
<view class="login-page theme-{{theme}}" wx:if="{{!isLoggedIn}}">
  <view class="login-hero">
    <view class="login-logo-text">校园墙</view>
    <text class="login-title">校园墙查询</text>
    <text class="login-subtitle">登录后可使用 AI 问答、保存个人偏好</text>
  </view>

  <view class="login-features">
    <view class="feature-item">
      <text class="feature-text">校园贴文搜索</text>
    </view>
    <view class="feature-item">
      <text class="feature-text">AI 智能问答</text>
    </view>
    <view class="feature-item">
      <text class="feature-text">个人资料管理</text>
    </view>
  </view>

  <button class="wx-login-btn" bindtap="onLogin" loading="{{logging}}" disabled="{{logging}}">
    <text wx:if="{{!logging}}">微信一键登录</text>
    <text wx:else>登录中...</text>
  </button>
  <text class="login-tip">登录即表示你同意相关服务协议</text>
</view>

<!-- ===== 已登录 - 个人中心 ===== -->
<view class="profile-page theme-{{theme}}" wx:if="{{isLoggedIn}}">

  <!-- 头部卡片 -->
  <view class="profile-header">
    <view class="header-blob blob-1"></view>
    <view class="header-blob blob-2"></view>
    <view class="header-blob blob-3"></view>

    <view class="header-content">
      <view class="avatar-wrap" bindtap="onChangeAvatar">
        <view class="avatar-ring"></view>
        <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
        <view class="avatar-edit">
          <text class="edit-icon">+</text>
        </view>
      </view>
      <view class="nickname-wrap" bindtap="onEditNickname">
        <text class="nickname">{{nickname}}</text>
        <text class="nickname-arrow">›</text>
      </view>
      <text class="uid">ID: {{openidShort}}</text>
    </view>
  </view>

  <!-- 信息卡片 -->
  <view class="section-card">
    <view class="section-title">个人信息</view>

    <view class="info-row" bindtap="onEditNickname">
      <text class="info-label">昵称</text>
      <view class="info-right">
        <text class="info-value">{{nickname}}</text>
        <text class="info-arrow">›</text>
      </view>
    </view>

    <view class="info-row" bindtap="onEditGender">
      <text class="info-label">性别</text>
      <view class="info-right">
        <text class="info-value">{{genderText}}</text>
        <text class="info-arrow">›</text>
      </view>
    </view>

    <view class="info-row" bindtap="onEditCollege">
      <text class="info-label">学院</text>
      <view class="info-right">
        <text class="info-value">{{college || '未设置'}}</text>
        <text class="info-arrow">›</text>
      </view>
    </view>

    <view class="info-row" bindtap="onEditGrade">
      <text class="info-label">年级</text>
      <view class="info-right">
        <text class="info-value">{{grade || '未设置'}}</text>
        <text class="info-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 使用统计 -->
  <view class="stats-card">
    <view class="stats-grid">
      <view class="stats-item">
        <view class="stats-bg stats-bg-1"></view>
        <text class="stats-num">{{searchCount}}</text>
        <text class="stats-label">搜索次数</text>
      </view>
      <view class="stats-item">
        <view class="stats-bg stats-bg-2"></view>
        <text class="stats-num">{{chatCount}}</text>
        <text class="stats-label">AI问答</text>
      </view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="section-card">
    <view class="info-row" bindtap="onOpenThemePicker">
      <text class="info-label">外观主题</text>
      <view class="info-right">
        <text class="info-value">{{currentThemeName}}</text>
        <text class="info-arrow">›</text>
      </view>
    </view>

    <view class="info-row info-row-share">
      <text class="info-label">分享给朋友</text>
      <view class="info-right">
        <text class="info-arrow">›</text>
      </view>
      <button class="share-overlay" open-type="share" hover-class="share-overlay-hover"></button>
    </view>

    <view class="info-row" bindtap="onClearCache">
      <text class="info-label">清除缓存</text>
      <view class="info-right">
        <text class="info-value" style="color:#999">{{cacheSize}}</text>
        <text class="info-arrow">›</text>
      </view>
    </view>

    <view class="info-row" bindtap="onAbout">
      <text class="info-label">关于</text>
      <view class="info-right">
        <text class="info-value" style="color:#999">v1.0.0</text>
        <text class="info-arrow">›</text>
      </view>
    </view>

    <view class="info-row" bindtap="onLogout">
      <text class="info-label" style="color:#e74c3c">退出登录</text>
      <view class="info-right">
        <text class="info-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 底部 -->
  <view class="footer-text">校园墙查询 · 仅供校内使用</view>

</view>

<!-- 主题选择弹窗 -->
<view class="modal-mask" wx:if="{{showThemePicker}}" bindtap="onCloseThemePicker">
  <view class="theme-modal" catchtap="">
    <view class="theme-modal-title">选择外观主题</view>
    <view class="theme-list">
      <view
        wx:for="{{themeList}}"
        wx:key="key"
        class="theme-card {{theme === item.key ? 'theme-card-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSelectTheme"
      >
        <view
          class="theme-preview"
          style="background: linear-gradient(135deg, {{item.gradient[0]}} 0%, {{item.gradient[1]}} 50%, {{item.gradient[2]}} 100%);"
        >
          <view class="theme-dot dot-1" style="background: {{item.primary}}"></view>
          <view class="theme-dot dot-2" style="background: {{item.accent}}"></view>
          <view class="theme-check" wx:if="{{theme === item.key}}">✓</view>
        </view>
        <view class="theme-info">
          <text class="theme-name">{{item.name}}</text>
          <text class="theme-sub">{{item.sub}}</text>
          <text class="theme-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
    <view class="theme-modal-close" bindtap="onCloseThemePicker">完成</view>
  </view>
</view>

<!-- 编辑昵称弹窗 -->
<view class="modal-mask" wx:if="{{showNicknameModal}}" bindtap="closeNicknameModal">
  <view class="modal-box" catchtap="">
    <view class="modal-title">修改昵称</view>
    <input
      type="nickname"
      class="modal-input"
      value="{{nicknameInput}}"
      placeholder="点击获取微信昵称"
      maxlength="20"
      bindinput="onNicknameInput"
      focus="{{showNicknameModal}}"
    />
    <view class="modal-btns">
      <view class="modal-btn cancel" bindtap="closeNicknameModal">取消</view>
      <view class="modal-btn confirm" bindtap="confirmNickname">确定</view>
    </view>
  </view>
</view>
