/* ─── Login Page ─── */
.login-page {
  min-height: 100vh;
  background: var(--c-hero);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  padding-bottom: var(--tab-bar-area);
}

.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}

.login-logo-text {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
  border: 4rpx solid rgba(255,255,255,.3);
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
}

.login-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,.65);
  text-align: center;
}

.login-features {
  display: flex;
  gap: 32rpx;
  margin-bottom: 80rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,.12);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  flex: 1;
}


.feature-text {
  font-size: 22rpx;
  color: rgba(255,255,255,.85);
  white-space: nowrap;
}

.wx-login-btn {
  width: 100% !important;
  height: 96rpx;
  background: #07c160 !important;
  color: #fff !important;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none !important;
  letter-spacing: 2rpx;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 96rpx !important;
}

.wx-login-btn::after {
  border: none;
}

.wx-login-btn[disabled] {
  background: rgba(7,193,96,.6) !important;
  color: rgba(255,255,255,.8) !important;
}

.login-tip {
  font-size: 22rpx;
  color: rgba(255,255,255,.4);
  margin-top: 24rpx;
}

/* ─── Profile Page ─── */
.profile-page {
  min-height: 100vh;
  background: var(--c-bg-page);
  padding-bottom: calc(40rpx + var(--tab-bar-area));
}

/* ─── Header ─── */
.profile-header {
  position: relative;
  background: var(--c-hero);
  padding: 70rpx 0 60rpx;
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-hero);
}

.header-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(40rpx);
  opacity: 0.55;
  pointer-events: none;
}

.blob-1 {
  width: 280rpx;
  height: 280rpx;
  background: var(--c-hero-blob-1);
  top: -80rpx;
  right: -60rpx;
}

.blob-2 {
  width: 220rpx;
  height: 220rpx;
  background: var(--c-hero-blob-2);
  bottom: -40rpx;
  left: -40rpx;
  opacity: 0.4;
}

.blob-3 {
  width: 160rpx;
  height: 160rpx;
  background: var(--c-hero-blob-3);
  top: 50%;
  left: 30%;
  opacity: 0.35;
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.avatar-ring {
  position: absolute;
  inset: -8rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255,255,255,.8), rgba(255,255,255,.2));
  filter: blur(2rpx);
}

.avatar {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,.6);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.12);
}

.avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 48rpx;
  height: 48rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.15);
  z-index: 2;
}

.edit-icon {
  font-size: 28rpx;
  color: var(--c-primary);
  font-weight: 700;
  line-height: 1;
}

.nickname-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.nickname {
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,.1);
}

.nickname-arrow {
  font-size: 32rpx;
  color: rgba(255,255,255,.7);
}

.uid {
  font-size: 22rpx;
  color: rgba(255,255,255,.75);
  background: rgba(255,255,255,.18);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
}

/* ─── Section Card ─── */
.section-card {
  background: var(--c-card);
  margin: 0 24rpx 24rpx;
  border-radius: var(--r-card);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-text-dim);
  padding: 24rpx 28rpx 8rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 22rpx;
  background: linear-gradient(180deg, var(--c-primary), var(--c-primary-2));
  border-radius: 3rpx;
  margin-right: 12rpx;
}

/* ─── Stats Card ─── */
.stats-card {
  margin: 0 24rpx 24rpx;
  border-radius: var(--r-card);
  overflow: hidden;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0;
}

.stats-grid .stats-item {
  position: relative;
  background: var(--c-card);
  border-radius: var(--r-card-sm);
  padding: 36rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.stats-bg {
  position: absolute;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  filter: blur(30rpx);
  opacity: 0.4;
  top: -40rpx;
  right: -30rpx;
  pointer-events: none;
}

.stats-bg-1 {
  background: radial-gradient(circle, var(--c-primary) 0%, transparent 70%);
}

.stats-bg-2 {
  background: radial-gradient(circle, var(--c-warn) 0%, transparent 70%);
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  position: relative;
}

.info-row-btn {
  width: 100%;
  background: transparent;
  border: none;
  border-radius: 0;
  text-align: left;
  font-size: 28rpx;
  font-weight: normal;
  line-height: normal;
  margin: 0;
  color: inherit;
}

.info-row-btn::after {
  border: none;
}

.info-row-hover {
  background: #f9f9f9;
}

.info-row::after {
  content: '';
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 0;
  height: 1rpx;
  background: #f0f0f0;
}

.info-row:last-child::after {
  display: none;
}

.info-row:active {
  background: #f9f9f9;
}

.info-label {
  font-size: 28rpx;
  color: #333;
}

.info-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-value {
  font-size: 28rpx;
  color: #666;
}

.info-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.stats-num {
  position: relative;
  font-size: 52rpx;
  font-weight: 800;
  background: linear-gradient(135deg, var(--c-primary), var(--c-primary-2));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1.1;
}

.stats-grid .stats-item:nth-child(2) .stats-num {
  background: linear-gradient(135deg, var(--c-warn), var(--c-accent));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.stats-label {
  position: relative;
  font-size: 24rpx;
  color: var(--c-text-dim);
}

/* ─── Footer ─── */
.footer-text {
  text-align: center;
  font-size: 22rpx;
  color: #c0c8d4;
  padding: 40rpx 0 20rpx;
}

.info-row {
  background: transparent;
}

.info-arrow {
  color: #d0d6df;
}

/* ─── Modal ─── */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-box {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 32rpx;
  color: #333;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}

.modal-input:focus {
  border-color: #4A90D9;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn.cancel {
  background: #f3f4f6;
  color: #666;
}

.modal-btn.confirm {
  background: var(--c-primary);
  color: #fff;
}

/* ─── Theme Picker Modal ─── */
.theme-modal {
  width: 640rpx;
  max-width: 90vw;
  background: var(--c-card);
  border-radius: var(--r-card);
  padding: 36rpx 32rpx 24rpx;
}

.theme-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--c-text);
  text-align: center;
  margin-bottom: 28rpx;
}

.theme-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.theme-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx;
  border-radius: var(--r-card-sm);
  border: 2rpx solid var(--c-divider);
  transition: all 0.2s;
}

.theme-card-active {
  border-color: var(--c-primary);
  background: var(--c-card-soft);
}

.theme-preview {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.08);
}

.theme-dot {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,.7);
}

.dot-1 {
  top: 20rpx;
  left: 20rpx;
}

.dot-2 {
  bottom: 20rpx;
  right: 20rpx;
}

.theme-check {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,.35);
  color: #fff;
  font-size: 48rpx;
  font-weight: 800;
  border-radius: 24rpx;
}

.theme-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.theme-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-text);
}

.theme-sub {
  font-size: 22rpx;
  color: var(--c-text-dim);
  font-family: -apple-system, "Helvetica Neue", sans-serif;
}

.theme-desc {
  font-size: 22rpx;
  color: var(--c-text-dim);
  margin-top: 4rpx;
}

.theme-modal-close {
  margin-top: 28rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--c-primary);
  color: #fff;
  border-radius: var(--r-btn);
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn:active {
  opacity: .8;
}
