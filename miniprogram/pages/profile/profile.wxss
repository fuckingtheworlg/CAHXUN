/* ─── Login Page ─── */
.login-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #4A90D9 0%, #2c5f9e 50%, #1a3a66 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  padding-bottom: var(--tab-bar-area);
}

.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}

.login-logo-text {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
  border: 4rpx solid rgba(255,255,255,.3);
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
}

.login-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,.65);
  text-align: center;
}

.login-features {
  display: flex;
  gap: 32rpx;
  margin-bottom: 80rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,.12);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  flex: 1;
}


.feature-text {
  font-size: 22rpx;
  color: rgba(255,255,255,.85);
  white-space: nowrap;
}

.wx-login-btn {
  width: 100% !important;
  height: 96rpx;
  background: #07c160 !important;
  color: #fff !important;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none !important;
  letter-spacing: 2rpx;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 96rpx !important;
}

.wx-login-btn::after {
  border: none;
}

.wx-login-btn[disabled] {
  background: rgba(7,193,96,.6) !important;
  color: rgba(255,255,255,.8) !important;
}

.login-tip {
  font-size: 22rpx;
  color: rgba(255,255,255,.4);
  margin-top: 24rpx;
}

/* ─── Profile Page ─── */
.profile-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(40rpx + var(--tab-bar-area));
}

/* ─── Header ─── */
.profile-header {
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  padding: 60rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,.5);
}

.avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 44rpx;
  height: 44rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.15);
}

.edit-icon {
  font-size: 26rpx;
  color: #666;
  font-weight: 700;
  line-height: 1;
}

.nickname-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.nickname-arrow {
  font-size: 32rpx;
  color: rgba(255,255,255,.6);
}

.uid {
  font-size: 24rpx;
  color: rgba(255,255,255,.6);
}

/* ─── Section Card ─── */
.section-card {
  background: #fff;
  margin: 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #999;
  padding: 24rpx 28rpx 8rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  position: relative;
}

.info-row-btn {
  width: 100%;
  background: transparent;
  border: none;
  border-radius: 0;
  text-align: left;
  font-size: 28rpx;
  font-weight: normal;
  line-height: normal;
  margin: 0;
  color: inherit;
}

.info-row-btn::after {
  border: none;
}

.info-row-hover {
  background: #f9f9f9;
}

.info-row::after {
  content: '';
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 0;
  height: 1rpx;
  background: #f0f0f0;
}

.info-row:last-child::after {
  display: none;
}

.info-row:active {
  background: #f9f9f9;
}

.info-label {
  font-size: 28rpx;
  color: #333;
}

.info-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-value {
  font-size: 28rpx;
  color: #666;
}

.info-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* ─── Stats ─── */
.stats-row {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stats-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #4A90D9;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

/* ─── Footer ─── */
.footer-text {
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  padding: 40rpx 0 20rpx;
}

/* ─── Modal ─── */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-box {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 32rpx;
  color: #333;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}

.modal-input:focus {
  border-color: #4A90D9;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn.cancel {
  background: #f3f4f6;
  color: #666;
}

.modal-btn.confirm {
  background: #4A90D9;
  color: #fff;
}

.modal-btn:active {
  opacity: .8;
}
