.bubble-wrap {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
  padding: 0 16rpx;
}

.bubble-wrap.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.bubble-wrap.user .avatar {
  background: linear-gradient(135deg, var(--c-primary) 0%, var(--c-primary-2) 100%);
  box-shadow: var(--shadow-primary);
}

.bubble-wrap.assistant .avatar {
  background: linear-gradient(135deg, var(--c-primary-2) 0%, var(--c-accent) 100%);
  box-shadow: var(--shadow-primary);
}

.avatar-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.bubble {
  max-width: 75%;
  padding: 22rpx 28rpx;
  border-radius: 24rpx;
  position: relative;
  display: flex;
  align-items: flex-end;
}

.bubble-wrap.user .bubble {
  background: linear-gradient(135deg, var(--c-primary) 0%, var(--c-primary-2) 100%);
  margin-right: 16rpx;
  border-top-right-radius: 8rpx;
  box-shadow: var(--shadow-primary);
}

.bubble-wrap.assistant .bubble {
  background: var(--c-card);
  margin-left: 16rpx;
  border-top-left-radius: 8rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--c-card-soft);
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
}

.bubble-wrap.user .bubble-text {
  color: #fff;
}

.bubble-wrap.assistant .bubble-text {
  color: var(--c-text);
}

.typing-cursor {
  width: 4rpx;
  height: 28rpx;
  background: var(--c-primary-2);
  margin-left: 4rpx;
  animation: blink 0.8s infinite;
  flex-shrink: 0;
}

@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}
